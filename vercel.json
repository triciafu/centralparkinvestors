{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/pages/o1101-exhibita",
      "destination": "/pages/o1101/exhibita",
      "permanent": true
    },
    {
      "source": "/pages/cc01-exhibita",
      "destination": "/pages/cc01/exhibita",
      "permanent": true
    },
    {
      "source": "/pages/cc01-exhibitb",
      "destination": "/pages/cc01/exhibitb",
      "permanent": true
    },
    {
      "source": "/pages/cc01-exhibitc",
      "destination": "/pages/cc01/exhibitc",
      "permanent": true
    },
    {
      "source": "/pages/cc01-exhibitd",
      "destination": "/pages/cc01/exhibitd",
      "permanent": true
    },
    {
      "source": "/pages/exhibith",
      "destination": "/pages/cc01/exhibith",
      "permanent": true
    },
    {
      "source": "/pages/exhibit-e",
      "destination": "/pages/cc01/exhibith",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
